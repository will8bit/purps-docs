{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "PURPS API",
  "description": "Everything purps.lol can do, as JSON. No key, no signup.",
  "colors": {
    "primary": "#3A49B8",
    "light": "#4757CC",
    "dark": "#3A49B8"
  },
  "background": {
    "color": {
      "light": "#F2F1EF",
      "dark": "#0E0F1A"
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://purps.lol"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "family": "Geist"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "styling": {
    "codeblocks": "system"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "index",
              "guides/signing",
              "guides/errors-and-limits"
            ],
            "icon": "rocket"
          },
          {
            "group": "Launch",
            "pages": [
              "guides/launch-solana",
              "guides/launch-pumpfun",
              "guides/launch-pons",
              "guides/redirect"
            ],
            "icon": "sparkles"
          },
          {
            "group": "After launch",
            "pages": [
              "guides/manage",
              "guides/creator-authority"
            ],
            "icon": "settings-2"
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "code",
        "groups": [
          {
            "group": "Coins",
            "openapi": "/openapi.json",
            "pages": [
              "GET /coins",
              "GET /coins/{mint}",
              "GET /index",
              "GET /search",
              "GET /launches",
              "GET /markets",
              "GET /pairs"
            ],
            "icon": "coins"
          },
          {
            "group": "Launch on purps.lol",
            "openapi": "/openapi.json",
            "pages": [
              "GET /launch-options",
              "POST /launches",
              "GET /launches/{mint}",
              "POST /transactions/send",
              "GET /transactions/{signature}"
            ],
            "icon": "/icons/purps.svg"
          },
          {
            "group": "Launch on pump.fun",
            "openapi": "/openapi.json",
            "pages": [
              "POST /pumpfun/launches",
              "POST /pumpfun/fees",
              "POST /redirects",
              "POST /transactions/send",
              "GET /transactions/{signature}"
            ],
            "icon": "/icons/pumpfun.svg"
          },
          {
            "group": "Redirect a pump.fun coin",
            "openapi": "/openapi.json",
            "pages": [
              "GET /redirects/{mint}",
              "POST /pumpfun/fees",
              "POST /redirects",
              "POST /transactions/send",
              "GET /transactions/{signature}"
            ],
            "icon": "/icons/pumpfun.svg"
          },
          {
            "group": "Launch on Pons",
            "openapi": "/openapi.json",
            "pages": [
              "POST /pons/launches/prepare",
              "POST /pons/launches/submit",
              "GET /pons/assets/{address}",
              "GET /pons/launches/{ref}",
              "POST /pons/register/prepare",
              "POST /pons/register/submit"
            ],
            "icon": "/icons/pons.svg"
          },
          {
            "group": "Manage a coin",
            "openapi": "/openapi.json",
            "pages": [
              "POST /coins/{mint}/strategy/prepare",
              "POST /coins/{mint}/strategy/submit"
            ],
            "icon": "sliders-horizontal"
          },
          {
            "group": "Creator authority",
            "openapi": "/openapi.json",
            "pages": [
              "GET /coins/{mint}/authority",
              "GET /coins/{mint}/changes",
              "POST /coins/{mint}/authority/prepare",
              "POST /coins/{mint}/authority/submit"
            ],
            "icon": "shield-check"
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "purps.lol",
          "href": "https://purps.lol",
          "icon": "globe"
        },
        {
          "anchor": "llms.txt",
          "href": "https://purps.lol/llms.txt",
          "icon": "bot"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "purps.lol",
        "href": "https://purps.lol"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Create a coin",
      "href": "https://purps.lol/create"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/buypurps",
      "telegram": "https://t.me/buypurps"
    }
  },
  "icons": {
    "library": "lucide"
  }
}